<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F7F9">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="朋友圈助手" android:textSize="28sp" android:textStyle="bold" android:textColor="#111827" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="独立版 · 无登录 · 无会员 · 微信 8.0.79 优先适配" android:textSize="14sp" android:textColor="#6B7280" />
        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="① 开启无障碍服务" />
        <Button android:id="@+id/btnWechat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="② 打开微信" />
        <Button android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="③ 显示/隐藏微信悬浮栏" />
        <Button android:id="@+id/btnLatest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看最近一次克隆文案" />
        <Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="克隆历史" />
        <Button android:id="@+id/btnMaterials" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="素材库（接收系统分享的图片/视频）" />
        <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:background="#FFFFFF" android:text="使用方法：开启无障碍 → 打开微信朋友圈 → 在目标内容停留 → 点击悬浮栏“克隆当前”。" android:textColor="#374151" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="说明：仅用于你有权复制或重新发布的内容。不会绕过朋友圈可见范围、账号登录、风控或验证码；最终“发表”需要你自己确认。" android:textColor="#9CA3AF" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
